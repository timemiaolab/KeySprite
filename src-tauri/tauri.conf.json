{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "KeySprite",
  "version": "0.1.2",
  "identifier": "com.keysprite.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "preferences",
        "title": "KeySprite 设置",
        "width": 440,
        "height": 520,
        "resizable": false,
        "visible": false,
        "center": true,
        "skipTaskbar": true,
        "decorations": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "minWidth": 400,
        "minHeight": 440
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
